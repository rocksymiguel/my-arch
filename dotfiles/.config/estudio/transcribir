#!/bin/bash
# Transcribe un audio de clase a un apunte en Markdown (en local). Ver transcribir.py.
#   transcribir <audio> [tiny|base|small|medium]
V="$HOME/.local/share/estudio/venv/bin/python"
[ -x "$V" ] || { echo "Falta el entorno de voz. Ejecuta: bash ~/my-arch/install/post.sh estudio" >&2; exit 1; }
AQUI="$(dirname "$(readlink -f "$0")")"
source "$AQUI/vault-env"
exec "$V" "$AQUI/transcribir.py" "$@"
