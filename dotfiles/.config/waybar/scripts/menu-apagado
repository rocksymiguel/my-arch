#!/bin/bash
# Menú de apagado en rofi: modo juego, bloquear, suspender, cerrar sesión, reiniciar, apagar.
pkill -x rofi 2>/dev/null && sleep 0.2
menu() { rofi -dmenu -i -p "$1" -l "$2" -theme-str 'window { width: 22em; }'; }

op="$(printf '%s\n' "󰊗  Modo juego" "󰌾  Bloquear" "󰤄  Suspender" "󰍃  Cerrar sesión" "󰜉  Reiniciar" "󰐥  Apagar" | menu "󰐥  " 6)" || exit 0


case "$op" in
    *"Modo juego")    ~/.config/theme/modo-bin juego ;;
    *Bloquear)       ~/.config/theme/bloquear-bin ;;
    *Suspender)      systemctl suspend ;;
    *"Cerrar sesión") hyprctl dispatch 'hl.dsp.exit()' ;;
    *Reiniciar)      systemctl reboot ;;
    *Apagar)         systemctl poweroff ;;
esac
