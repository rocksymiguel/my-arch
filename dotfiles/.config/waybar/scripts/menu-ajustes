#!/bin/bash
# Menú de ajustes en rofi: tema, vidrio, inactividad, fondo y energía.
# Navegación: al elegir algo se vuelve al menú anterior; Esc vuelve atrás
# (y en el menú principal, cierra).
T="$HOME/.config/theme"
C="${XDG_CACHE_HOME:-$HOME/.cache}/theme"

# Si quedó un rofi abierto (escondido o atascado), cerrarlo: solo puede haber uno
pkill -x rofi 2>/dev/null && sleep 0.2

menu() { rofi -dmenu -i -p "$1" -l "$2" -theme-str 'window { width: 36em; }'; }
marca() { [ "$1" = "$2" ] && echo "● $3" || echo "  $3"; }
mins() { [ "$1" -eq 0 ] && echo "nunca" || echo "$1 min"; }
limpiar() { local s="${1#● }"; echo "${s#  }"; }
v() { sed -n "s/^$1=//p" "$C/inactividad"; }
energia_es() { case "$1" in balanced) echo "equilibrado" ;; power-saver) echo "ahorro" ;; performance) echo "rendimiento" ;; *) echo "$1" ;; esac; }

menu_tema() {
    local act sel
    act="$("$T/tema" actual)"
    sel="$(printf '%s\n' "$(marca "$act" oscuro Oscuro)" "$(marca "$act" claro Claro)" "$(marca "$act" dinamico Dinámico)" | menu "Tema " 3)" || return 0
    case "$sel" in *Oscuro) "$T/tema" oscuro ;; *Claro) "$T/tema" claro ;; *Dinámico) "$T/tema" dinamico ;; esac >/dev/null
}

menu_vidrio() {
    local act sel
    act="$(sed -n 's/^glass=//p' "$C/glass" 2>/dev/null)"
    sel="$(printf '%s\n' "$(marca "$act" total Total)" "$(marca "$act" oscurecer Oscurecer)" | menu "Vidrio " 2)" || return 0
    case "$sel" in *Total) "$T/vidrio-bin" total ;; *Oscurecer) "$T/vidrio-bin" oscurecer ;; esac >/dev/null
}

elegir_minutos() {
    local clave="$1" titulo="$2" actual sel opciones
    actual="$(v "$clave")"
    case "$clave" in
        atenuar)   opciones="0 2 5 10" ;;
        bloquear)  opciones="0 5 10 15" ;;
        apagar)    opciones="0 10 15 30" ;;
        suspender) opciones="0 30 60" ;;
    esac
    sel="$(for m in $opciones; do marca "$actual" "$m" "$(mins "$m")"; done | menu "$titulo " "$(wc -w <<< "$opciones")")" || return 0
    sel="$(limpiar "$sel")"
    [ "$sel" = nunca ] && sel=0 || sel="${sel% min}"
    "$T/inactividad-bin" "$clave" "$sel"
}

menu_inactividad() {
    local sel pausa
    "$T/inactividad-bin" ver >/dev/null
    while true; do
        if pgrep -x hypridle >/dev/null; then pausa="Pausar (pantalla siempre encendida)"; else pausa="Reanudar inactividad"; fi
        sel="$(printf '%s\n' \
            "Atenuar el brillo: $(mins "$(v atenuar)")" \
            "Bloquear: $(mins "$(v bloquear)")" \
            "Apagar la pantalla: $(mins "$(v apagar)")" \
            "Suspender: $(mins "$(v suspender)")" \
            "$pausa" | menu "Inactividad " 5)" || return 0
        case "$sel" in
            Atenuar*)   elegir_minutos atenuar "Atenuar tras" ;;
            Bloquear*)  elegir_minutos bloquear "Bloquear tras" ;;
            Apagar*)    elegir_minutos apagar "Apagar pantalla tras" ;;
            Suspender*) elegir_minutos suspender "Suspender tras" ;;
            Pausar*)    pkill -x hypridle; notify-send -a ajustes "Inactividad en pausa" "La pantalla no se atenuará ni se bloqueará" ;;
            Reanudar*)  setsid -f hypridle >/dev/null 2>&1; notify-send -a ajustes "Inactividad activa" ;;
        esac
    done
}

menu_fondo() {
    local rot sel
    while true; do
        rot="$(cat "$C/rotar" 2>/dev/null || echo 0)"
        sel="$(printf '%s\n' "Elegir fondo…" "Siguiente fondo" \
            "$(marca "$rot" 0 "Rotar: apagado")" "$(marca "$rot" 5 "Rotar cada 5 min")" \
            "$(marca "$rot" 10 "Rotar cada 10 min")" "$(marca "$rot" 30 "Rotar cada 30 min")" | menu "Fondo " 6)" || return 0
        case "$sel" in
            Elegir*)    setsid -f waypaper >/dev/null 2>&1; exit 0 ;;
            Siguiente*) "$T/fondos-bin" siguiente ;;
            *apagado)   "$T/fondos-bin" rotar 0 ;;
            *"cada 5 min")  "$T/fondos-bin" rotar 5 ;;
            *"cada 10 min") "$T/fondos-bin" rotar 10 ;;
            *"cada 30 min") "$T/fondos-bin" rotar 30 ;;
        esac
    done
}

menu_energia() {
    local act sel
    act="$(powerprofilesctl get 2>/dev/null)"
    sel="$(printf '%s\n' "$(marca "$act" balanced Equilibrado)" "$(marca "$act" power-saver Ahorro)" | menu "Energía " 2)" || return 0
    case "$sel" in *Equilibrado) powerprofilesctl set balanced ;; *Ahorro) powerprofilesctl set power-saver ;; esac
}

while true; do
    pgrep -x hypridle >/dev/null && inact="activa" || inact="pausada"
    op="$(printf '%s\n' \
        "󰏘  Tema: $("$T/tema" actual)" \
        "󰂵  Vidrio: $(sed -n 's/^glass=//p' "$C/glass" 2>/dev/null)" \
        "󰅶  Inactividad: $inact" \
        "󰸉  Fondo de pantalla" \
        "󰓅  Energía: $(energia_es "$(powerprofilesctl get 2>/dev/null)")" \
        | menu "󰒓  " 5)" || exit 0
    case "$op" in
        *Tema:*)        menu_tema ;;
        *Vidrio:*)      menu_vidrio ;;
        *Inactividad:*) menu_inactividad ;;
        *Fondo*)        menu_fondo ;;
        *Energía:*)     menu_energia ;;
    esac
done
