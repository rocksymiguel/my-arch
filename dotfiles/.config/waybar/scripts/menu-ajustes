#!/bin/bash
# Menú de ajustes en rofi: tema, vidrio, tamaño, inactividad, fondo y sistema (limpiar, actualizar,
# fondos de arranque).
# Navegación: al elegir algo se vuelve al menú anterior; Esc vuelve atrás
# (y en el menú principal, cierra).
T="$HOME/.config/theme"
C="${XDG_CACHE_HOME:-$HOME/.cache}/theme"

# Si quedó un rofi abierto (escondido o atascado), cerrarlo: solo puede haber uno
pkill -x rofi 2>/dev/null && sleep 0.2

menu() { rofi -dmenu -i -p "$1" -l "$2" -theme-str 'window { width: 36em; }'; }
marca() { [ "$1" = "$2" ] && echo "● $3" || echo "  $3"; }
mins() { [ "$1" -eq 0 ] && echo "nunca" || echo "$1 min"; }
limpiar() { local s="${1#● }"; echo "${s#  }"; }
v() { sed -n "s/^$1=//p" "$C/inactividad"; }

menu_tema() {
    local act sel
    act="$("$T/tema" actual)"
    sel="$(printf '%s\n' "$(marca "$act" oscuro Oscuro)" "$(marca "$act" claro Claro)" | menu "Tema " 2)" || return 0
    case "$sel" in *Oscuro) "$T/tema" oscuro ;; *Claro) "$T/tema" claro ;; esac >/dev/null
}

menu_vidrio() {
    local act sel medios
    act="$(sed -n 's/^glass=//p' "$C/glass" 2>/dev/null)"
    medios="$(cat "$C/media-opaca" 2>/dev/null || echo si)"
    sel="$(printf '%s\n' "$(marca "$act" total Total)" "$(marca "$act" oscurecer Oscurecer)" \
        "  Vídeo e imágenes opacos: $medios" | menu "Vidrio " 3)" || return 0
    case "$sel" in
        *Total)    "$T/vidrio-bin" total ;;
        *Oscurecer) "$T/vidrio-bin" oscurecer ;;
        *opacos*)  "$T/vidrio-bin" medios "$([ "$medios" = no ] && echo si || echo no)" ;;
    esac >/dev/null
}

# Tamaño de la interfaz: al elegir se aplica y el menú sigue abierto, para comparar
menu_tamano() {
    local act sel
    while true; do
        act="$(cat "$C/tamano" 2>/dev/null || echo 100)"
        sel="$(for t in 50 75 90 100 110 125 150 175 200; do marca "$act" "$t" "$t %"; done | menu "Tamaño " 9)" || return 0
        sel="$(limpiar "$sel")"
        "$T/tamano-bin" "${sel% %}" >/dev/null
    done
}

elegir_minutos() {
    local clave="$1" titulo="$2" actual sel opciones
    actual="$(v "$clave")"
    case "$clave" in
        atenuar)   opciones="0 2 5 10" ;;
        bloquear)  opciones="0 5 10 15" ;;
        apagar)    opciones="0 10 15 30" ;;
        suspender) opciones="0 30 60" ;;
    esac
    sel="$(for m in $opciones; do marca "$actual" "$m" "$(mins "$m")"; done | menu "$titulo " "$(wc -w <<< "$opciones")")" || return 0
    sel="$(limpiar "$sel")"
    [ "$sel" = nunca ] && sel=0 || sel="${sel% min}"
    "$T/inactividad-bin" "$clave" "$sel"
}

menu_inactividad() {
    local sel pausa
    "$T/inactividad-bin" ver >/dev/null
    while true; do
        if pgrep -x hypridle >/dev/null; then pausa="Pausar (pantalla siempre encendida)"; else pausa="Reanudar inactividad"; fi
        sel="$(printf '%s\n' \
            "Atenuar el brillo: $(mins "$(v atenuar)")" \
            "Bloquear: $(mins "$(v bloquear)")" \
            "Apagar la pantalla: $(mins "$(v apagar)")" \
            "Suspender: $(mins "$(v suspender)")" \
            "$pausa" | menu "Inactividad " 5)" || return 0
        case "$sel" in
            Atenuar*)   elegir_minutos atenuar "Atenuar tras" ;;
            Bloquear*)  elegir_minutos bloquear "Bloquear tras" ;;
            Apagar*)    elegir_minutos apagar "Apagar pantalla tras" ;;
            Suspender*) elegir_minutos suspender "Suspender tras" ;;
            Pausar*)    pkill -x hypridle; notify-send -a ajustes "Inactividad en pausa" "La pantalla no se atenuará ni se bloqueará" ;;
            Reanudar*)  setsid -f hypridle >/dev/null 2>&1; notify-send -a ajustes "Inactividad activa" ;;
        esac
    done
}

menu_fondo() {
    local rot sel
    while true; do
        rot="$(cat "$C/rotar" 2>/dev/null || echo 0)"
        sel="$(printf '%s\n' "Elegir fondo…" "Siguiente fondo" \
            "$(marca "$rot" 0 "Rotar: apagado")" "$(marca "$rot" 5 "Rotar cada 5 min")" \
            "$(marca "$rot" 10 "Rotar cada 10 min")" "$(marca "$rot" 30 "Rotar cada 30 min")" | menu "Fondo " 6)" || return 0
        case "$sel" in
            Elegir*)    setsid -f "$T/fondos-bin" elegir >/dev/null 2>&1; exit 0 ;;
            Siguiente*) "$T/fondos-bin" siguiente ;;
            *apagado)   "$T/fondos-bin" rotar 0 ;;
            *"cada 5 min")  "$T/fondos-bin" rotar 5 ;;
            *"cada 10 min") "$T/fondos-bin" rotar 10 ;;
            *"cada 30 min") "$T/fondos-bin" rotar 30 ;;
        esac
    done
}

# Terminal flotante para lo que pide contraseña o conviene ver (hyprland.lua: clase ajustes-terminal)
en_terminal() {
    setsid -f kitty --class ajustes-terminal --title "$1" -e bash -c "$2; echo; read -rp 'Listo. Pulsa Enter para cerrar.'" >/dev/null 2>&1
}

# Limpiar: en segundo plano y sin contraseña (sudoers solo para /usr/local/bin/limpiar-sistema,
# una copia de install/limpiar.sh que instala install/sistema.sh); avisa al terminar
limpiar_sistema() {
    if [ ! -x /usr/local/bin/limpiar-sistema ]; then
        en_terminal "Limpiar" "sudo bash ~/my-arch/install/limpiar.sh"
        return
    fi
    notify-send -a ajustes "Limpiando el sistema…"
    ( r="$(sudo -n /usr/local/bin/limpiar-sistema 2>&1 | tail -n 1)"
      notify-send -a ajustes "Limpieza terminada" "${r#==> LISTO: }" ) >/dev/null 2>&1 &
}

menu_sistema() {
    local sel
    sel="$(printf '%s
'         "󰃢  Limpiar (huérfanos, cachés, registros)"         "󰚰  Actualizar (pacman y AUR)"         "󰋩  Fondos de arranque (copiar a Limine)" | menu "Sistema " 3)" || return 0
    case "$sel" in
        *Limpiar*)    limpiar_sistema ;;
        *Actualizar*) en_terminal "Actualizar" "paru -Syu" ;;
        *Fondos*)     en_terminal "Fondos de arranque" "sudo bash ~/my-arch/install/limine.sh" ;;
    esac
    exit 0
}

while true; do
    pgrep -x hypridle >/dev/null && inact="activa" || inact="pausada"
    op="$(printf '%s\n' \
        "󰏘  Tema: $("$T/tema" actual)" \
        "󰂵  Vidrio: $(sed -n 's/^glass=//p' "$C/glass" 2>/dev/null)" \
        "󰁌  Tamaño: $(cat "$C/tamano" 2>/dev/null || echo 100) %" \
        "󰅶  Inactividad: $inact" \
        "󰸉  Fondo de pantalla" \
        "󰒋  Sistema" \
        | menu "󰒓  " 6)" || exit 0
    case "$op" in
        *Tema:*)        menu_tema ;;
        *Vidrio:*)      menu_vidrio ;;
        *Tamaño:*)      menu_tamano ;;
        *Inactividad:*) menu_inactividad ;;
        *Fondo*)        menu_fondo ;;
        *Sistema)       menu_sistema ;;
    esac
done
