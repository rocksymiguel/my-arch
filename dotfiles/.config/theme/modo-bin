#!/bin/bash
# Modos de la laptop: escritorio (Hyprland) o juego (Steam Big Picture con Gamescope).
#   modo arrancar    -> lo llama fish al iniciar sesión en tty1: abre el modo elegido en el
#                       menú de arranque (modo=escritorio | modo=juego) y, al cerrarse, el
#                       que se haya pedido; si no se pidió ninguno, vuelve a la terminal
#   modo juego       -> desde el escritorio: cierra Hyprland y abre el modo juego
#   modo escritorio  -> pide el escritorio (Steam lo hace con "Cambiar a escritorio")
#   modo actual      -> muestra el modo con el que arrancó la laptop
C="${XDG_CACHE_HOME:-$HOME/.cache}/theme"
SIG="$C/siguiente-modo"
mkdir -p "$C"

del_arranque() { grep -oE '\bmodo=[a-z]+' /proc/cmdline | cut -d= -f2 | head -n 1; }

# Variables que deja un modo en el entorno de systemd y que confunden al siguiente
# (p. ej. WAYLAND_DISPLAY=wayland-1 de Hyprland hace que Gamescope se abra "dentro" de él)
limpiar_entorno() {
    systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY XAUTHORITY         HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE 2>/dev/null
    unset WAYLAND_DISPLAY DISPLAY XAUTHORITY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP
}

escritorio() {
    limpiar_entorno
    # El primer escritorio tras encender se abre bloqueado (inicio sin contraseña), también si se
    # arrancó en modo juego: hyprlock desbloquea el llavero y así gelly no lo pide
    BLOQUEAR_AL_INICIO="${1:-0}" XDG_SESSION_TYPE=wayland start-hyprland
}

# Animación de Plymouth entre un modo y otro, para no ver la consola. Plymouth tiene que soltar la
# pantalla antes de abrir el modo, así que se cierra dejando su última imagen hasta que este dibuje.
# Sin /usr/local/bin/modo-splash (install/arranque.sh) no hace nada.
transicion() {
    sudo -n /usr/local/bin/modo-splash mostrar >/dev/null 2>&1 || return 0
    sleep 1.5
    sudo -n /usr/local/bin/modo-splash ocultar >/dev/null 2>&1 || true
}

# Steam abierto en el escritorio (escondido en la bandeja) chocaría con el del modo juego: se cierra antes
cerrar_steam() {
    pgrep -x steam >/dev/null || return 0
    steam -shutdown >/dev/null 2>&1
    for _ in $(seq 1 40); do pgrep -x steam >/dev/null || return 0; sleep 0.5; done
    pkill -x steam
}

juego() {
    cerrar_steam
    limpiar_entorno
    gamescope-session-plus steam
}

case "${1:-}" in
    arrancar)
        modo="$(del_arranque)"; modo="${modo:-escritorio}"
        primera=1                        # 1 hasta que se abra el primer escritorio
        rm -f "$SIG"
        while true; do
            case "$modo" in
                juego) juego ;;
                *)     escritorio "$primera"; primera=0 ;;
            esac
            modo="$(cat "$SIG" 2>/dev/null)"
            rm -f "$SIG"
            [ -n "$modo" ] || break      # se cerró sin pedir otro modo: volver a la terminal
            transicion
        done ;;
    juego)
        echo juego > "$SIG"
        hyprctl dispatch 'hl.dsp.exit()' >/dev/null 2>&1 ;;
    escritorio)
        echo escritorio > "$SIG"
        steam -shutdown >/dev/null 2>&1 ;;
    actual)
        m="$(del_arranque)"; echo "${m:-escritorio}" ;;
    *) sed -n '2,8p' "$0" | sed 's/^# //'; exit 1 ;;
esac
