#!/bin/bash
# Cambia cómo se colocan las ventanas en Hyprland.
#   mosaico            -> muestra el diseño activo
#   mosaico <diseño>   -> dwindle | master | scrolling
set -euo pipefail
F="${XDG_CACHE_HOME:-$HOME/.cache}/theme/mosaico"
mkdir -p "$(dirname "$F")"
if [ $# -eq 0 ]; then
    echo "Activo: $(cat "$F" 2>/dev/null || echo dwindle)"
    echo "Diseños: dwindle master scrolling"
    exit 0
fi
case "$1" in dwindle|master|scrolling) ;; *) echo "Diseño desconocido: $1 (dwindle, master o scrolling)" >&2; exit 1 ;; esac
echo "$1" > "$F"
hyprctl reload >/dev/null
echo "Mosaico: $1"
