#!/bin/bash
# Cambia el cursor del ratón al momento.
#   cursor              -> lista numerada (el activo, marcado)
#   cursor <n>          -> por número de la lista, p. ej. cursor 3
#   cursor <texto>      -> por parte del nombre, p. ej. cursor ice, cursor nordzy
#   cursor siguiente    -> el siguiente de la lista (para probarlos)
# También desde Ajustes → Cursor.
set -euo pipefail
C="${XDG_CACHE_HOME:-$HOME/.cache}/theme"
mkdir -p "$C"
TAM=24

# Solo variantes diestras: sin -Right, -left, -lefthand
disponibles() {
    for d in /usr/share/icons/*/cursors "$HOME"/.local/share/icons/*/cursors; do
        [ -d "$d" ] && basename "$(dirname "$d")"
    done | grep -viE '^(default|Adwaita|hicolor)$|-(right|left|lefthand)$' | sort -u
}
actual() { cat "$C/cursor" 2>/dev/null || echo Bibata-Modern-Classic; }

aplicar() {
    local n="$1"
    echo "$n" > "$C/cursor"
    hyprctl setcursor "$n" "$TAM" >/dev/null 2>&1 || true
    gsettings set org.gnome.desktop.interface cursor-theme "$n" 2>/dev/null || true
    sed -i "s/^gtk-cursor-theme-name=.*/gtk-cursor-theme-name=$n/" "$HOME/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini"
    printf '[Icon Theme]\nInherits=%s\n' "$n" > "$(readlink -f "$HOME/.icons/default/index.theme")"
    echo "Cursor: $n"
}

mapfile -t L < <(disponibles)
case "${1:-}" in
    "")
        for i in "${!L[@]}"; do
            [ "${L[$i]}" = "$(actual)" ] && m="●" || m=" "
            printf ' %s %2d  %s\n' "$m" $((i + 1)) "${L[$i]}"
        done ;;
    lista) printf '%s\n' "${L[@]}" ;;
    siguiente)
        i=0; for j in "${!L[@]}"; do [ "${L[$j]}" = "$(actual)" ] && i=$(( (j + 1) % ${#L[@]} )); done
        aplicar "${L[$i]}" ;;
    *)
        if [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le ${#L[@]} ]; then
            aplicar "${L[$(( $1 - 1 ))]}"; exit 0
        fi
        mapfile -t M < <(printf '%s\n' "${L[@]}" | grep -iF -- "$1")
        if [ ${#M[@]} -eq 1 ]; then aplicar "${M[0]}"
        elif [ ${#M[@]} -eq 0 ]; then echo "Ningún cursor coincide con «$1». Escribe «cursor» para ver la lista." >&2; exit 1
        else
            # Si coincide exacto, ese; si no, pedir más detalle
            for m in "${M[@]}"; do [ "${m,,}" = "${1,,}" ] && { aplicar "$m"; exit 0; }; done
            echo "Varios coinciden con «$1»:" >&2; printf '  %s\n' "${M[@]}" >&2; exit 1
        fi ;;
esac
