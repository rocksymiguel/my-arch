// Barra en islas para Hyprland. Plantilla: `tema` genera ~/.config/waybar/config.jsonc
// con el tamaño elegido ({{e:N}} = N px a 100 %)
{
    "layer": "top",
    "reload_style_on_change": true, // `tema acentos` cambia el color sin reiniciar la barra
    "position": "top",
    "height": {{e:28}},
    "margin-top": {{e:4}},
    "margin-left": {{e:6}},
    "margin-right": {{e:6}},
    "spacing": {{e:6}},
    "modules-left": [
        "hyprland/workspaces",
        "custom/musica"
    ],
    "modules-center": [
        "clock",
        "custom/clima"
    ],
    "modules-right": [
        "custom/clase",
        "custom/grabando",
        "group/sistema",
        "group/conexion",
        "group/controles",
        "battery",
        "custom/notificaciones",
        "custom/ajustes",
        "custom/apagado"
    ],
    "hyprland/workspaces": {
        "format": "{name} {windows}",
        "format-window-separator": " ",
        "window-rewrite": {
            "class<kitty>": "󰆍",
            "class<zen.*>": "󰈹",
            "class<thunar>": "󰉋",
            "class<io.m51.Gelly>": "󰝚",
            "class<org.pulseaudio.pavucontrol>": "󰕾",
            "class<blueman-manager>": "󰂯",
            "class<chrome-.*__-jellyfin>": "󰎁",
            "class<chrome-.*__-navidrome>": "󰝚",
            "class<chrome-.*__-immich>": "󰋩",
            "class<chrome-.*__-syncthingdelnas>": "󰓦",
            "class<chrome-.*__-truenas>": "󰒋",
            "class<chrome-.*__-proxmox>": "󰒋"
        },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "persistent-workspaces": {
            "*": 3
        }
    },
    "custom/musica": {
        // Lo que suena (o está en pausa); sin nada, sin isla (waybar/scripts/musica)
        "exec": "~/.config/waybar/scripts/musica",
        "return-type": "json",
        "escape": true,
        "max-length": 40,
        "on-click": "playerctl -p \"$(cat $XDG_RUNTIME_DIR/musica-reproductor)\" play-pause",
        "on-click-right": "~/.config/theme/musica-bin mostrar",
        "on-scroll-up": "playerctl -p \"$(cat $XDG_RUNTIME_DIR/musica-reproductor)\" next",
        "on-scroll-down": "playerctl -p \"$(cat $XDG_RUNTIME_DIR/musica-reproductor)\" previous"
    },
    "clock": {
        "format": "{:%H:%M · %a %d}",
        "format-alt": "{:%A %d de %B de %Y, %H:%M}",
        "locale": "es_EC.UTF-8",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "custom/clima": {
        "exec": "~/.config/waybar/scripts/clima",
        "return-type": "json",
        "interval": 1800,
        "on-click": "xdg-open https://wttr.in/Daule?lang=es"
    },
    "group/sistema": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "memory",
            "custom/temperatura"
        ]
    },
    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 2,
        "on-click": "kitty -e btop",
        "tooltip-format": "Procesador: {usage}%"
    },
    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 2,
        "tooltip-format": "{used:0.1f} de {total:0.1f} GiB",
        "on-click": "kitty -e btop"
    },
    "custom/temperatura": {
        "exec": "~/.config/waybar/scripts/temperatura",
        "return-type": "json",
        "interval": 2,
        "on-click": "kitty -e btop"
    },
    "tray": {
        "icon-size": {{e:16}},
        "spacing": {{e:8}}
    },
    "group/controles": {
        "orientation": "horizontal",
        "modules": [
            "backlight",
            "pulseaudio"
        ]
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
        "on-scroll-down": "brightnessctl -e4 -n2 set 5%-",
        "tooltip-format": "Brillo: {percent}%"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "Volumen: {volume}% · {desc}"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁼",
            "󰁾",
            "󰂀",
            "󰁹"
        ],
        "tooltip-format": "Batería: {capacity}% · {timeTo}"
    },
    "custom/ajustes": {
        "format": "{}",
        "tooltip-format": "Ajustes",
        "on-click": "~/.config/waybar/scripts/menu-ajustes",
        "exec": "echo '󰒓'",
        "interval": "once"
    },
    "custom/apagado": {
        "format": "{}",
        "tooltip-format": "Apagar, reiniciar, bloquear…",
        "on-click": "~/.config/waybar/scripts/menu-apagado",
        "exec": "echo '󰐥'",
        "interval": "once"
    },
    "custom/notificaciones": {
        "tooltip": false,
        "format": "{icon} {text}",
        "format-icons": {
            "notification": "󰂚",
            "none": "󰂚",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "command -v swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "group/conexion": {
        "orientation": "horizontal",
        "modules": [
            "custom/avion",
            "tray"
        ]
    },
    "custom/avion": {
        "exec": "~/.config/theme/avion-bin estado",
        "interval": "once",
        "signal": 9,
        "tooltip": false,
        "on-click": "rfkill unblock all",
        "return-type": "json"
    },
    "custom/clase": {
        // Botón del micrófono: grabar clases y transcribirlas (waybar/scripts/menu-clase); roja mientras graba
        "exec": "~/.config/estudio/grabar-clase estado",
        "return-type": "json",
        "interval": 1,
        "signal": 11,
        "on-click": "~/.config/waybar/scripts/menu-clase"
    },
    "custom/grabando": {
        "exec": "~/.config/theme/grabar-bin estado",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "on-click": "~/.config/theme/grabar-bin"
    }
}
