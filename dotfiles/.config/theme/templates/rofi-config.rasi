/* rofi minimalista: una lista centrada con buscador.
 * Plantilla: `tema` genera ~/.config/rofi/config.rasi con el tamaño elegido ({{e:N}} = N px a 100 %).
 * Los colores salen del tema activo (colors.rasi lo genera `tema`). */
configuration {
    modi: "drun,calc,run";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    font: "JetBrainsMono Nerd Font {{d:10}}";
    terminal: "kitty";
    drun-display-format: "{name}";
    display-drun: "󰍉";
    display-run: "󰍉";
    display-calc: "󰃬";
    display-dmenu: "󰍉";
    matching: "fuzzy";
    sort: true;
    hover-select: true;
    click-to-exit: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

@import "colors.rasi"

* {
    background-color: transparent;
    text-color: @texto;
}

window {
    location: center;
    width: {{e:330}}px;
    border: {{e:2}}px;
    border-color: @acento;
    border-radius: {{e:10}}px;
    background-color: @fondo;
    padding: {{e:10}}px;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing: {{e:8}}px;
}

/* Resultado de la calculadora (rofi-calc); en los demás modos no hay mensaje y no se ve */
message {
    padding: {{e:2}}px {{e:6}}px;
    border: 0;
}
textbox {
    text-color: @acento;
}

inputbar {
    children: [ prompt, entry ];
    spacing: {{e:8}}px;
    padding: {{e:4}}px {{e:6}}px;
}

prompt {
    text-color: @acento;
}

entry {
    placeholder: "Escribe para buscar…";
    placeholder-color: @tenue;
    cursor: text;
}

listview {
    border: 0;
    lines: 10;
    fixed-height: false;
    scrollbar: false;
    spacing: {{e:2}}px;
}

element {
    padding: {{e:4}}px {{e:8}}px;
    border-radius: {{e:6}}px;
    spacing: {{e:8}}px;
}

element selected {
    background-color: @seleccion;
}

element-icon {
    size: 1.2em;
}

element-text {
    vertical-align: 0.5;
    highlight: bold;
}

element selected element-text {
    text-color: @acento;
}

/* Sin los colores del tema por defecto de rofi (filas crema y línea punteada) */
element normal.normal, element alternate.normal, element normal.urgent,
element alternate.urgent, element normal.active, element alternate.active {
    background-color: transparent;
    text-color: @texto;
}
element selected.normal, element selected.urgent, element selected.active {
    background-color: @seleccion;
    text-color: @acento;
}
element-icon, element-text {
    background-color: inherit;
    text-color: inherit;
}
