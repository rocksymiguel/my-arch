#!/bin/bash
# Elige cuánto rebotan las animaciones (y activa la animación rebote).
#   rebote            -> muestra el nivel activo
#   rebote <nivel>    -> suave | medio | fuerte | exagerado
set -euo pipefail
C="${XDG_CACHE_HOME:-$HOME/.cache}/theme"
mkdir -p "$C"
if [ $# -eq 0 ]; then
    echo "Activo: $(cat "$C/rebote" 2>/dev/null || echo medio)"
    echo "Niveles: suave medio fuerte exagerado"
    exit 0
fi
case "$1" in suave|medio|fuerte|exagerado) ;; *) echo "Nivel desconocido: $1 (suave, medio, fuerte o exagerado)" >&2; exit 1 ;; esac
echo "$1" > "$C/rebote"
echo rebote > "$C/anim"
hyprctl reload >/dev/null
echo "Rebote: $1"
