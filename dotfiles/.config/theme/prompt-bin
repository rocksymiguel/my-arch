#!/bin/bash
# Cambia el estilo del prompt (starship) en todas las terminales nuevas y en la actual al pulsar Enter.
#   prompt           -> muestra el activo y los disponibles
#   prompt <estilo>  -> una-linea | dos-lineas | islas | minimo
D="$HOME/.config/starship"
C="${XDG_CACHE_HOME:-$HOME/.cache}/theme"
mkdir -p "$C"
if [ $# -eq 0 ]; then
    echo "Activo: $(basename "$(readlink -f "$C/starship.toml" 2>/dev/null)" .toml)"
    echo "Estilos: $(ls "$D" | sed 's/\.toml$//' | tr '\n' ' ')"
    exit 0
fi
[ -f "$D/$1.toml" ] || { echo "Estilo desconocido: $1" >&2; "$0"; exit 1; }
ln -sf "$D/$1.toml" "$C/starship.toml"
echo "Prompt: $1"
