#!/usr/bin/env python3
# Logo de fastfetch sacado del fondo actual: recorta al personaje quitando el color liso del fondo.
#   logo actualizar        -> pone en ~/.cache/theme/logo.png el logo del fondo actual (lo llama `tema`)
#   logo preparar          -> recorta los fondos que falten (al iniciar, en segundo plano)
# Sale con los colores del fondo; si así apenas se ve sobre la terminal (personaje negro en modo
# oscuro, pálido en modo claro), en dos tonos: acento del fondo y texto del tema.
# Los recortes se guardan en ~/.cache/theme/logos y solo se rehacen si el fondo cambia.
import glob, os, sys

HOME = os.path.expanduser("~")
T = os.path.join(HOME, ".config/theme")
C = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache")), "theme")
FONDOS = os.path.join(HOME, "Imágenes/Fondos")
RECORTES = os.path.join(C, "logos")
LOGO = os.path.join(C, "logo.png")
VISIBLE = 0.35      # parte mínima del personaje que debe contrastar con la terminal
RESPALDO = os.path.join(HOME, ".config/fastfetch/logo.png")   # si algo falla, queda el Mightyena de siempre
LADO = 300          # lado mayor del logo en píxeles
TRABAJO = 1280      # ancho al que se reduce el fondo antes de analizarlo

def leer(ruta, defecto=""):
    try:
        return open(ruta).read().strip()
    except OSError:
        return defecto

def colores():
    # Primer valor de cada clave: acentos del fondo y luego la paleta del modo (como `tema`)
    modo = leer(os.path.join(C, "modo"), "oscuro")
    vals = {}
    for ruta in (os.path.join(C, "acentos.colors"), os.path.join(T, "themes", f"{modo}.colors")):
        for l in leer(ruta).splitlines():
            if "=" in l and not l.startswith("#"):
                k, v = l.split("=", 1)
                vals.setdefault(k.strip(), v.strip())
    hexa = lambda h: tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))
    return modo, hexa(vals.get("accent", "88c0d0")), hexa(vals.get("text", "eceff4")), hexa(vals.get("bg", "1f232b"))

def pixeles(img):
    return getattr(img, "get_flattened_data", img.getdata)()

def visible(img, bg):
    # Parte opaca del personaje cuyo color se distingue del fondo de la terminal ("redmean", parecida al ojo)
    tot = vis = 0
    for r, g, b, a in pixeles(img.convert("RGBA")):
        if a < 128:
            continue
        rm = (r + bg[0]) / 2
        dr, dg, db = r - bg[0], g - bg[1], b - bg[2]
        tot += 1
        vis += ((2 + rm / 256) * dr * dr + 4 * dg * dg + (2 + (255 - rm) / 256) * db * db) >= 150 ** 2
    return vis / max(tot, 1)

def recorte_de(fondo):
    return os.path.join(RECORTES, os.path.basename(fondo) + ".png")

def recortar(fondo):
    from PIL import Image, ImageChops, ImageFilter
    img = Image.open(fondo).convert("RGB")
    img = img.resize((TRABAJO, round(img.height * TRABAJO / img.width)), Image.LANCZOS)
    w, h = img.size

    # Color del fondo: el más repetido en el borde de la imagen
    borde = [img.getpixel((x, y)) for x in range(0, w, 4) for y in (0, h - 1)] + \
            [img.getpixel((x, y)) for y in range(0, h, 4) for x in (0, w - 1)]
    cuenta = {}
    for p in borde:
        q = tuple(v // 6 * 6 for v in p)
        cuenta[q] = cuenta.get(q, 0) + 1
    grupo = max(cuenta, key=cuenta.get)
    similares = [p for p in borde if tuple(v // 6 * 6 for v in p) == grupo]
    bg = tuple(sorted(p[i] for p in similares)[len(similares) // 2] for i in range(3))

    # Alfa según lo lejos que está cada píxel del color de fondo (mayor diferencia por canal)
    r, g, b = ImageChops.difference(img, Image.new("RGB", img.size, bg)).split()
    dist = ImageChops.lighter(ImageChops.lighter(r, g), b)
    # Rampa corta: hay dibujos de poco contraste (Snorlax solo se separa 19 niveles de su fondo)
    alfa = dist.point(lambda d: 0 if d <= 4 else 255 if d >= 14 else (d - 4) * 255 // 10)

    # Caja del personaje sin motas sueltas (la erosión borra puntitos y bordes de 2-3 px)
    caja = alfa.point(lambda a: 255 if a > 128 else 0).filter(ImageFilter.MinFilter(7)).getbbox()
    if not caja:
        raise ValueError("no encuentro nada distinto del fondo")
    m = 12
    caja = (max(caja[0] - m, 0), max(caja[1] - m, 0), min(caja[2] + m, w), min(caja[3] + m, h))
    img, alfa = img.crop(caja), alfa.crop(caja)
    esc = LADO / max(img.size)
    tam = (max(1, round(img.width * esc)), max(1, round(img.height * esc)))
    img, alfa = img.resize(tam, Image.LANCZOS), alfa.resize(tam, Image.LANCZOS)

    # Quita el tinte del fondo en los bordes semitransparentes: c = (pixel - (1 - a) * bg) / a
    px, pa = img.load(), alfa.load()
    for y in range(tam[1]):
        for x in range(tam[0]):
            a = pa[x, y] / 255
            if 0 < a < 1:
                px[x, y] = tuple(max(0, min(255, round((px[x, y][i] - (1 - a) * bg[i]) / a))) for i in range(3))
    img.putalpha(alfa)
    return img

def asegurar(fondo):
    dest = recorte_de(fondo)
    if os.path.exists(dest) and os.path.getmtime(dest) >= os.path.getmtime(fondo):
        return dest
    os.makedirs(RECORTES, exist_ok=True)
    recortar(fondo).save(dest + ".tmp.png")
    os.replace(dest + ".tmp.png", dest)
    return dest

def dos_tonos(img, modo, acento, texto):
    # Zonas oscuras -> acento y claras -> texto (en modo claro al revés, para que no se pierdan en el fondo)
    from PIL import Image
    oscuro, claro = (texto, acento) if modo == "claro" else (acento, texto)
    lum = img.convert("L")
    vals = sorted(v for v, a in zip(pixeles(lum), pixeles(img.getchannel("A"))) if a > 128)
    lo, hi = vals[len(vals) // 50], vals[-len(vals) // 50 - 1]   # percentiles 2 y 98
    rango = max(hi - lo, 1)
    tabla = [max(0, min(255, (v - lo) * 255 // rango)) for v in range(256)]
    t = lum.point(tabla)
    out = Image.merge("RGB", [t.point([oscuro[i] + (claro[i] - oscuro[i]) * k // 255 for k in range(256)])
                              for i in range(3)])
    out.putalpha(img.getchannel("A"))
    return out

def actualizar():
    from PIL import Image
    fondo = leer(os.path.join(C, "fondo"))
    os.makedirs(C, exist_ok=True)
    try:
        img = Image.open(asegurar(fondo))
        modo, acento, texto, bg = colores()
        if visible(img, bg) < VISIBLE:
            img = dos_tonos(img, modo, acento, texto)
    except Exception as e:
        print(f"logo: {os.path.basename(fondo) or 'sin fondo'}: {e}; uso el de respaldo", file=sys.stderr)
        img = Image.open(RESPALDO)
    img.save(LOGO + ".tmp.png")
    os.replace(LOGO + ".tmp.png", LOGO)

def preparar():
    for f in sorted(glob.glob(os.path.join(FONDOS, "*"))):
        if f.lower().endswith((".png", ".jpg", ".jpeg", ".webp")):
            try:
                asegurar(f)
            except Exception as e:
                print(f"logo: {os.path.basename(f)}: {e}", file=sys.stderr)

if __name__ == "__main__":
    orden = sys.argv[1] if len(sys.argv) > 1 else ""
    if orden == "actualizar":
        actualizar()
    elif orden == "preparar":
        preparar()
    else:
        print(open(__file__).read().split("\nimport")[0].split("\n", 1)[1].replace("# ", ""))
        sys.exit(1)
