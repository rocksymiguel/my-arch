#!/bin/bash
# Arranque del escritorio: lo llama Hyprland al iniciar (un solo comando).
# Deja un registro en ~/.cache/theme/inicio.log para ver qué falló si algo no aparece.
T="$HOME/.config/theme"
C="${XDG_CACHE_HOME:-$HOME/.cache}/theme"
mkdir -p "$C"
exec >"$C/inicio.log" 2>&1
set -x
date

# Lanza un programa en segundo plano, salvo que ya esté funcionando (así se puede repetir sin duplicados)
# Inicio automático sin contraseña: el escritorio se abre bloqueado
[ "${BLOQUEAR_AL_INICIO:-0}" = 1 ] && setsid -f "$T/bloquear-bin" >/dev/null 2>&1

lanzar() {
    pgrep -f -x "$*" >/dev/null && return 0
    setsid -f "$@" >/dev/null 2>&1
}

systemctl --user start hyprpolkitagent
lanzar swaync
lanzar awww-daemon
"$T/inactividad-bin"; lanzar hypridle
lanzar "$T/fondos-bin" demonio
lanzar "$T/avion-bin" vigilar          # iconos de Wi-Fi/Bluetooth o avión
lanzar feishin                         # escondido en special:musica; Super + F lo muestra
lanzar wl-paste --type text --watch cliphist store
lanzar wl-paste --type image --watch cliphist store

# Cursor y fuente de las apps GTK (claro/oscuro, iconos y tema los pone `tema`)
gsettings set org.gnome.desktop.interface cursor-theme "$(cat "$C/cursor" 2>/dev/null || echo Bibata-Modern-Ice)"
gsettings set org.gnome.desktop.interface cursor-size 24
gsettings set org.gnome.desktop.interface font-name 'JetBrainsMono Nerd Font 9'

# Barra: arrancarla ya, por si `tema` fallara
lanzar waybar

# Fondo y tema (tema también reinicia la barra y la bandeja con los colores del modo)
for _ in $(seq 1 20); do awww query >/dev/null 2>&1 && break; sleep 0.25; done
waypaper --restore
"$T/tema" "$("$T/tema" actual)"
sleep 2
pgrep -x waybar >/dev/null || lanzar waybar
echo "inicio terminado"
