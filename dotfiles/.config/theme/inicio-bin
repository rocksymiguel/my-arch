#!/bin/bash
# Arranque del escritorio: lo llama Hyprland al iniciar (un solo comando).
# Deja un registro en ~/.cache/theme/inicio.log para ver qué falló si algo no aparece.
T="$HOME/.config/theme"
C="${XDG_CACHE_HOME:-$HOME/.cache}/theme"
mkdir -p "$C"
exec >"$C/inicio.log" 2>&1
set -x
date

# Lanza un programa en segundo plano, salvo que ya esté funcionando (así se puede repetir sin duplicados)
# (el bloqueo del inicio sin contraseña lo lanza hyprland.lua antes que este script)
lanzar() {
    pgrep -f -x "$*" >/dev/null && return 0
    setsid -f "$@" >/dev/null 2>&1
}

systemctl --user start hyprpolkitagent
lanzar swaync
# Inicio bloqueado: awww-daemon repinta solo el último fondo al arrancar, así que espera a que
# hyprlock esté en pantalla (si no, se ve el fondo sin desenfocar antes del bloqueo)
if [ "${BLOQUEAR_AL_INICIO:-0}" = 1 ]; then
    for _ in $(seq 1 50); do pidof hyprlock >/dev/null && break; sleep 0.1; done
    sleep 1
fi
lanzar awww-daemon
"$T/inactividad-bin"; lanzar hypridle
lanzar "$T/fondos-bin" demonio
lanzar nice -n 19 "$T/fondos-bin" preparar     # miniaturas del selector de fondos (Super + W)
lanzar "$T/avion-bin" vigilar          # iconos de Wi-Fi/Bluetooth o avión
# gelly, escondido en special:musica (Super + G), cuando no hay bloqueo: pide sus credenciales al
# llavero, y este solo se abre al desbloquear (con la contraseña de hyprlock)
( while pidof hyprlock >/dev/null; do sleep 1; done; lanzar gelly ) &
# Steam escondido en la bandeja (-silent): tras el bloqueo y con el escritorio ya armado, porque
# tarda y gasta ~1,1 GB y no debe competir con el arranque. Solo si está instalado. modo-bin lo
# cierra antes de pasar al modo juego.
# Con tope de memoria (su propio cgroup): a 1,8 GB el kernel lo frena y a 2,2 GB solo se cierran
# procesos de Steam. Sin tope, el 2026-10-25 su parte web (steamwebhelper) agotó la RAM, el kernel
# la mató 8 veces, Steam la relanzaba y el escritorio se colgó.
# MemorySwapMax=0 es necesario: MemoryMax solo cuenta la RAM y sin esto el exceso se iba a zram,
# que al no comprimirse devolvía la presión a la RAM de todos (probado: de 4 GB a 1 GB libres).
# Un juego lanzado desde este Steam comparte el tope: los grandes, mejor en modo juego (sin tope).
# Solo con más de 5 GB de RAM total (con 8 GB el sistema ve ~5,9: el BIOS aparta 2 GB a la gráfica).
# Con 3,2 GB (módulo de la ranura sin detectarse) Steam + el escritorio dejan ~800 MB y se llena.
if command -v steam >/dev/null && [ "$(awk '/MemTotal/ {print $2}' /proc/meminfo)" -gt 5242880 ]; then
    ( while pidof hyprlock >/dev/null; do sleep 1; done; sleep 20
      pgrep -x steam >/dev/null || setsid -f systemd-run --user --scope --quiet \
          -p MemoryHigh=1800M -p MemoryMax=2200M -p MemorySwapMax=0 nice -n 10 steam -silent >/dev/null 2>&1 ) &
fi
lanzar wl-paste --type text --watch cliphist store
lanzar wl-paste --type image --watch cliphist store

# Cursor y fuente de las apps GTK (claro/oscuro, iconos y tema los pone `tema`)
gsettings set org.gnome.desktop.interface cursor-theme "$(cat "$C/cursor" 2>/dev/null || echo Bibata-Modern-Ice)"
gsettings set org.gnome.desktop.interface cursor-size 24
gsettings set org.gnome.desktop.interface font-name 'JetBrainsMono Nerd Font 9'

# Micrófono interno: el boost de fábrica (+30 dB) solo satura y amplifica ruido; con 1 (+10 dB) se oye la voz
for c in /proc/asound/card[0-9]*; do
    n="${c#/proc/asound/card}"
    amixer -c "$n" sget 'Internal Mic Boost' >/dev/null 2>&1 && amixer -c "$n" sset 'Internal Mic Boost' 1
done

# Fondo y tema (tema también arranca la barra y la bandeja con los colores del modo;
# así la barra se lanza una sola vez)
for _ in $(seq 1 20); do awww query >/dev/null 2>&1 && break; sleep 0.25; done
"$T/fondos-bin" restaurar
TEMA_SIN_AVISO=1 "$T/tema" "$("$T/tema" actual)"
sleep 2
pgrep -x waybar >/dev/null || lanzar waybar
echo "inicio terminado"
