#!/bin/bash
# Cambia el tema de todo el escritorio.
#   tema            -> pasa al siguiente modo (oscuro -> claro -> dinamico -> oscuro)
#   tema oscuro     -> Nord profundo
#   tema claro      -> Nord claro
#   tema dinamico   -> colores sacados del fondo actual con matugen
#   tema actual     -> muestra el modo activo
set -euo pipefail

T="$HOME/.config/theme"
C="$HOME/.config"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/theme"
ESTADO="$CACHE/modo"
mkdir -p "$CACHE"

modo_actual() { cat "$ESTADO" 2>/dev/null || echo oscuro; }

fondo_actual() {
    awww query 2>/dev/null | sed -n 's/.*image: *//p' | head -n 1
}

# Fondos por modo: en ~/Imágenes/Fondos, los que llevan "Dark Mode" en el nombre son
# para el oscuro y los que llevan "Light Mode", para el claro. Si el fondo actual ya
# es del modo, se queda; si no, se pone el primero de ese modo.
FONDOS="$HOME/Imágenes/Fondos"
poner_fondo() {
    local patron actual nuevo
    case "$1" in oscuro) patron="Dark Mode" ;; claro) patron="Light Mode" ;; *) return 0 ;; esac
    actual="$(fondo_actual)"
    [[ "$(basename "$actual")" == *"$patron"* ]] && return 0
    nuevo="$(find "$FONDOS" -maxdepth 1 -type f -name "*$patron*" 2>/dev/null | sort | head -n 1)"
    [ -n "$nuevo" ] || return 0
    awww img "$nuevo" --transition-type grow --transition-duration 1.5 --transition-fps 60 >/dev/null 2>&1 || return 0
    sed -i "s|^wallpaper = .*|wallpaper = ${nuevo/#$HOME/\~}|" "$C/waypaper/config.ini" 2>/dev/null || true
}

generar_dinamico() {
    local img; img="$(fondo_actual)"
    if [ -z "$img" ] || [ ! -f "$img" ]; then
        echo "No encuentro el fondo actual. Elige uno con waypaper (Super + W)." >&2
        return 1
    fi
    matugen image "$img" --json hex --dry-run --mode dark --prefer saturation \
        | python3 "$T/matugen-a-colors.py" > "$CACHE/dinamico.colors"
    echo "$CACHE/dinamico.colors"
}

renderizar() {
    local colores="$1" plantilla="$2" destino="$3" tmp glass
    tmp="$(mktemp)"
    glass="$CACHE/glass"
    [ -f "$glass" ] || cp "$T/vidrio/oscurecer.glass" "$glass"
    cp "$plantilla" "$tmp"
    while IFS='=' read -r k v; do
        [[ -z "$k" || "$k" == \#* ]] && continue
        sed -i "s|{{$k}}|$v|g" "$tmp"
    done < <(cat "$colores" "$glass")
    mv "$tmp" "$destino"
}

aplicar() {
    local modo="$1" colores
    case "$modo" in
        oscuro|claro) colores="$T/themes/$modo.colors" ;;
        dinamico)     colores="$(generar_dinamico)" || return 1 ;;
        *) echo "Modo desconocido: $modo (usa oscuro, claro o dinamico)" >&2; exit 1 ;;
    esac

    renderizar "$colores" "$T/templates/hypr-colors.lua"     "$C/hypr/colors.lua"
    renderizar "$colores" "$T/templates/hyprlock-colors.conf" "$C/hypr/colors-hyprlock.conf"
    renderizar "$colores" "$T/templates/waybar-colors.css"   "$C/waybar/colors.css"
    renderizar "$colores" "$T/templates/kitty-colors.conf"   "$C/kitty/colors.conf"
    renderizar "$colores" "$T/templates/fuzzel.ini"          "$C/fuzzel/fuzzel.ini"
    renderizar "$colores" "$T/templates/mako-config"         "$C/mako/config"

    local scheme icons
    scheme="$(sed -n 's/^scheme=//p' "$colores")"
    icons="$(sed -n 's/^icons=//p' "$colores")"
    echo "$modo" > "$ESTADO"

    # Recargar lo que esté abierto (si no hay sesión gráfica, no pasa nada)
    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || ls /run/user/"$(id -u)"/hypr/* >/dev/null 2>&1; then
        poner_fondo "$modo"
        hyprctl reload >/dev/null 2>&1 || true
        makoctl reload 2>/dev/null || true
        pkill -SIGUSR1 -x kitty 2>/dev/null || true
        gsettings set org.gnome.desktop.interface color-scheme "prefer-$scheme" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface icon-theme "$icons" 2>/dev/null || true
        # Iconos de la bandeja (Wi-Fi, Bluetooth) con los iconos del modo nuevo
        pkill -x nm-applet 2>/dev/null || true
        pkill -f blueman-applet 2>/dev/null || true
        pkill -x waybar 2>/dev/null || true
        (sleep 0.5; setsid -f waybar >/dev/null 2>&1; sleep 1; setsid -f nm-applet --indicator >/dev/null 2>&1; setsid -f blueman-applet >/dev/null 2>&1) &
        notify-send -a tema "Tema: $modo" 2>/dev/null || true
    fi
    sed -i "s/^gtk-application-prefer-dark-theme=.*/gtk-application-prefer-dark-theme=$([ "$scheme" = dark ] && echo 1 || echo 0)/; s/^gtk-icon-theme-name=.*/gtk-icon-theme-name=$icons/" \
        "$C/gtk-3.0/settings.ini" "$C/gtk-4.0/settings.ini"
    echo "Tema: $modo"
}

case "${1:-siguiente}" in
    actual)    modo_actual ;;
    siguiente)
        case "$(modo_actual)" in
            oscuro) aplicar claro ;;
            claro)  aplicar dinamico || aplicar oscuro ;;
            *)      aplicar oscuro ;;
        esac ;;
    *) aplicar "$1" ;;
esac
