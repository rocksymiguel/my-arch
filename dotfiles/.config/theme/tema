#!/bin/bash
# Cambia el tema de todo el escritorio.
#   tema            -> pasa al otro modo (oscuro <-> claro)
#   tema oscuro     -> Nord profundo
#   tema claro      -> Nord claro
#   tema acentos    -> vuelve a sacar los acentos del fondo actual (sin reiniciar la barra)
#   tema actual     -> muestra el modo activo
# El modo pone fondos, superficies, texto, GTK, iconos, cursor y carpetas; el fondo de
# pantalla solo pone el acento (bordes de ventana, barra, lanzador...) con matugen.
set -euo pipefail

T="$HOME/.config/theme"
C="$HOME/.config"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/theme"
ESTADO="$CACHE/modo"
mkdir -p "$CACHE"

modo_actual() { [ "$(cat "$ESTADO" 2>/dev/null)" = claro ] && echo claro || echo oscuro; }

# ¿Hay sesión gráfica a la que avisar?
grafico() { [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || ls /run/user/"$(id -u)"/hypr/* >/dev/null 2>&1; }

# El fondo lo recuerda `fondos-bin poner`; si no hay, se le pregunta a awww
fondo_actual() {
    cat "$CACHE/fondo" 2>/dev/null || awww query 2>/dev/null | sed -n 's/.*image: *//p' | head -n 1
}

# Fondos por modo: en ~/Imágenes/Fondos, los que llevan "Dark Mode" en el nombre son
# para el oscuro y los que llevan "Light Mode", para el claro. Si el fondo actual ya
# es del modo, se queda; si no, se pone el primero de ese modo.
FONDOS="$HOME/Imágenes/Fondos"
poner_fondo() {
    local patron actual nuevo
    case "$1" in oscuro) patron="Dark Mode" ;; claro) patron="Light Mode" ;; *) return 0 ;; esac
    actual="$(fondo_actual)"
    [[ "$(basename "$actual")" == *"$patron"* ]] && return 0
    nuevo="$(find "$FONDOS" -maxdepth 1 -type f -name "*$patron*" 2>/dev/null | sort | head -n 1)"
    [ -n "$nuevo" ] || return 0
    "$T/fondos-bin" poner "$nuevo" || true
}

# Acentos del fondo actual, en la variante del modo (matugen --mode dark|light)
generar_acentos() {
    local img scheme
    img="$(fondo_actual)"
    [ "$1" = claro ] && scheme=light || scheme=dark
    if [ -f "$img" ] && matugen image "$img" --json hex --dry-run --mode "$scheme" --prefer saturation \
            | python3 "$T/matugen-a-colors.py" > "$CACHE/acentos.tmp"; then
        mv "$CACHE/acentos.tmp" "$CACHE/acentos.colors"
    else
        rm -f "$CACHE/acentos.tmp" "$CACHE/acentos.colors"   # sin fondo o sin matugen: queda la paleta del modo
    fi
}

renderizar() {
    local colores="$1" plantilla="$2" destino="$3" tmp glass acentos
    tmp="$(mktemp)"
    glass="$CACHE/glass"
    [ -f "$glass" ] || cp "$T/vidrio/oscurecer.glass" "$glass"
    acentos="$CACHE/acentos.colors"
    [ -f "$acentos" ] || acentos=/dev/null
    cp "$plantilla" "$tmp"
    # Gana el primer valor de cada clave: primero los acentos del fondo, luego el modo
    while IFS='=' read -r k v; do
        [[ -z "$k" || "$k" == \#* ]] && continue
        sed -i "s|{{$k}}|$v|g" "$tmp"
    done < <(cat "$acentos" "$colores" "$glass")
    mv "$tmp" "$destino"
}

renderizar_todo() {
    local colores="$1"
    renderizar "$colores" "$T/templates/hypr-colors.lua"     "$C/hypr/colors.lua"
    renderizar "$colores" "$T/templates/hyprlock-colors.conf" "$C/hypr/colors-hyprlock.conf"
    renderizar "$colores" "$T/templates/waybar-colors.css"   "$C/waybar/colors.css"
    renderizar "$colores" "$T/templates/kitty-colors.conf"   "$C/kitty/colors.conf"
    mkdir -p "$C/rofi"
    renderizar "$colores" "$T/templates/rofi-colors.rasi"    "$C/rofi/colors.rasi"
    mkdir -p "$C/swaync"
    renderizar "$colores" "$T/templates/swaync.css"          "$C/swaync/style.css"
}

aplicar() {
    local modo="$1" colores
    case "$modo" in
        oscuro|claro) colores="$T/themes/$modo.colors" ;;
        *) echo "Modo desconocido: $modo (usa oscuro o claro)" >&2; exit 1 ;;
    esac

    grafico && poner_fondo "$modo"
    generar_acentos "$modo"
    renderizar_todo "$colores"

    local scheme icons gtk
    scheme="$(sed -n 's/^scheme=//p' "$colores")"
    icons="$(sed -n 's/^icons=//p' "$colores")"
    gtk="$(sed -n 's/^gtk=//p' "$colores")"
    # Cursor del modo (Hyprland lo lee de ~/.cache/theme/cursor al arrancar)
    local cursor; cursor="$(sed -n 's/^cursor=//p' "$colores")"
    if [ -n "$cursor" ]; then
        echo "$cursor" > "$CACHE/cursor"
        printf '[Icon Theme]\nInherits=%s\n' "$cursor" > "$(readlink -f "$HOME/.icons/default/index.theme")"
    fi
    # Color de carpetas en la copia personal de Papirus (~/.local/share/icons): sin contraseña
    local carpetas; carpetas="$(sed -n 's/^carpetas=//p' "$colores")"
    if [ -n "$carpetas" ] && [ -d "$HOME/.local/share/icons/$icons" ]; then
        (papirus-folders -C "$carpetas" -t "$icons" -o >/dev/null 2>&1 &)
    fi
    echo "$modo" > "$ESTADO"

    # Recargar lo que esté abierto (si no hay sesión gráfica, no pasa nada)
    if grafico; then
        hyprctl reload >/dev/null 2>&1 || true
        swaync-client -rs >/dev/null 2>&1 || true
        pkill -SIGUSR1 -x kitty 2>/dev/null || true
        gsettings set org.gnome.desktop.interface color-scheme "prefer-$scheme" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface icon-theme "$icons" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface gtk-theme "$gtk" 2>/dev/null || true
        hyprctl setcursor "$cursor" 24 >/dev/null 2>&1 || true
        gsettings set org.gnome.desktop.interface cursor-theme "$cursor" 2>/dev/null || true
        # Iconos de la bandeja (Wi-Fi, Bluetooth) con los iconos del modo nuevo
        pkill -x nm-applet 2>/dev/null || true
        pkill -f blueman-applet 2>/dev/null || true
        pkill -x waybar 2>/dev/null || true
        (sleep 0.5; setsid -f waybar >/dev/null 2>&1; sleep 1; ~/.config/theme/avion-bin bandeja) &
        [ -n "${TEMA_SIN_AVISO:-}" ] || notify-send -a tema "Tema: $modo" 2>/dev/null || true
    fi
    sed -i "s/^gtk-application-prefer-dark-theme=.*/gtk-application-prefer-dark-theme=$([ "$scheme" = dark ] && echo 1 || echo 0)/; s/^gtk-icon-theme-name=.*/gtk-icon-theme-name=$icons/; s/^gtk-theme-name=.*/gtk-theme-name=$gtk/; s/^gtk-cursor-theme-name=.*/gtk-cursor-theme-name=$cursor/" \
        "$C/gtk-3.0/settings.ini" "$C/gtk-4.0/settings.ini"
    echo "Tema: $modo"
}

# Solo cambia el acento: no toca la barra ni la bandeja (se usa al cambiar de fondo, también al rotar)
acentos() {
    local modo; modo="$(modo_actual)"
    generar_acentos "$modo"
    renderizar_todo "$T/themes/$modo.colors"
    if grafico; then
        hyprctl reload >/dev/null 2>&1 || true
        swaync-client -rs >/dev/null 2>&1 || true
        pkill -SIGUSR1 -x kitty 2>/dev/null || true
        # waybar recarga su estilo al ver el archivo escrito (reload_style_on_change); el contenido no cambia
        : >> "$C/waybar/style.css"
    fi
}

case "${1:-siguiente}" in
    actual)    modo_actual ;;
    acentos)   acentos ;;
    siguiente) [ "$(modo_actual)" = oscuro ] && aplicar claro || aplicar oscuro ;;
    *) aplicar "$1" ;;
esac
