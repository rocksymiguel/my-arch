#!/bin/bash
# Textos de la pantalla de bloqueo (hyprlock los ejecuta con cmd[…]).
#   bloqueo-info musica   -> artista · título, o nada
#   bloqueo-info mayus    -> aviso si Bloq Mayús está activado
case "${1:-}" in
    musica)
        t="$(playerctl metadata --format '{{artist}} · {{title}}' 2>/dev/null)"
        [ -n "$t" ] && echo "󰝚  $t" || echo " " ;;
    mayus)
        [ "$(cat /sys/class/leds/*::capslock/brightness 2>/dev/null | head -n 1)" = 1 ] && echo "󰪛  Bloq Mayús activado" || echo " " ;;
esac
